# HE200 EP board configuration

CONFIG_ARM_ARCH_TIMER=y
CONFIG_CACHE_MANAGEMENT=y
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=1000000000
CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000
CONFIG_NUM_IRQS=256

CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_UART_NS16550_DW8250_DW_APB=y
CONFIG_UART_NS16550_ACCESS_WORD_ONLY=y
CONFIG_UART_NS16550_WA_ISR_REENABLE_INTERRUPT=y

# Shell (Zephyr built-in modules only — see subsys/shell/modules/)
CONFIG_SHELL=y
CONFIG_SHELL_BACKEND_SERIAL=y
CONFIG_SHELL_BACKEND_SERIAL_INTERRUPT_DRIVEN=y
CONFIG_SHELL_BACKEND_SERIAL_LOG_LEVEL_NONE=y
CONFIG_SHELL_THREAD_PRIORITY_OVERRIDE=y
CONFIG_SHELL_THREAD_PRIORITY=10
CONFIG_SHELL_STACK_SIZE=4096
CONFIG_SHELL_TAB=y
CONFIG_SHELL_TAB_AUTOCOMPLETION=y
CONFIG_SHELL_HISTORY=y

CONFIG_KERNEL_SHELL=y
CONFIG_KERNEL_SHELL_PANIC_CMD=y
CONFIG_DEVICE_SHELL=y
CONFIG_DEVICE_SHELL_INIT_CMD=y
CONFIG_DEVMEM_SHELL=y
CONFIG_DATE_SHELL=y
CONFIG_REBOOT=y
CONFIG_SYS_HEAP_RUNTIME_STATS=y

# Per-thread CPU% (closest to top; shown in "kernel thread list")
CONFIG_THREAD_RUNTIME_STATS=y
CONFIG_SCHED_THREAD_USAGE=y
CONFIG_SCHED_THREAD_USAGE_ALL=y

# ISR vector table (hwirq -> handler); no ARM GICv3 register dump in upstream
CONFIG_ISR_TABLE_SHELL=y

# Logging shell: log list / log enable (requires non-minimal log mode)
CONFIG_LOG=y
CONFIG_LOG_MODE_IMMEDIATE=y
CONFIG_LOG_CMDS=y
CONFIG_LOG_RUNTIME_FILTERING=y
# printk must go to UART console, not log (Shell backend uses LOG_LEVEL_NONE)
# CONFIG_LOG_PRINTK is not set

# SMP: spin-table secondary boot (soc/lynxi/ka200/pm_cpu_ops_spin_table.c)
CONFIG_SMP=y
CONFIG_MP_MAX_NUM_CPUS=8
CONFIG_SOC_LYNXI_KA200_SPIN_TABLE=y

# prep_c 单字符 PLtbdDmi 常开；可选 CONFIG_SOC_KA200_BOOT_TRACE 见 he200_ep_boot_debug.conf
CONFIG_SOC_LYNXI_KA200_SHELL_SMP=y
CONFIG_SOC_PREP_HOOK=y
CONFIG_ARM64_VA_BITS_40=y
CONFIG_ARM64_PA_BITS_40=y
CONFIG_ARMV8_A_NS=y

# eMMC (lynxi,dwcmshc-sdhci @ 0x10040000, disk SD2) — 与后续外设一并编入 build_he200_ep_final
CONFIG_SDHC=y
CONFIG_SDHC_LYNXI_DWCMSHC=y
CONFIG_LYNXI_DWCMSHC_DEBUG=y
CONFIG_LYNXI_DWCMSHC_CMD_DEBUG=y
CONFIG_LYNXI_DWCMSHC_INTERRUPT=y
CONFIG_SDHC_LOG_LEVEL_DBG=y
CONFIG_SD_LOG_LEVEL_DBG=y
# CONFIG_LYNXI_DWCMSHC_IRQ_SELFTEST is not set
CONFIG_MMC_STACK=y
CONFIG_DISK_ACCESS=y
CONFIG_DISK_DRIVER_MMC=y

# GMAC 见 he200_ep_gmac.conf + he200_ep.dts &eth/&gpio_portd
