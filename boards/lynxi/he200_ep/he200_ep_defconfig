# HE200 EP board configuration

CONFIG_ARM_ARCH_TIMER=y
CONFIG_CACHE_MANAGEMENT=y
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=1000000000
CONFIG_SYS_CLOCK_TICKS_PER_SEC=100
CONFIG_NUM_IRQS=256

# Disable console and shell (UART driver not available yet)
CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_SHELL=y

# SPL boots zephyr.bin as u-boot.bin — no U-Boot UART setup
CONFIG_HE200_EP_EARLY_UART_DEBUG=y
CONFIG_ARM64_BOOT_DISABLE_DCACHE=y
CONFIG_SOC_PREP_HOOK=y
# CONFIG_ARM64_VA_BITS_32 is not set
# CONFIG_ARM64_PA_BITS_32 is not set
CONFIG_ARM64_VA_BITS_40=y
CONFIG_ARM64_PA_BITS_40=y
