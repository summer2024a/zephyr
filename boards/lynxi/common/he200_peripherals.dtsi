/*
 * HE200 / KA200 peripherals — aligned with lynxi-linux lynchip-lite-base.dtsi
 * and RT-Thread bsp/lynxi/he200/drivers/lynxi.h.
 *
 * All nodes default to "disabled" until Zephyr drivers + CPR clocks are ready.
 */

/ {
	soc {
		gpio: gpio@1000e000 {
			compatible = "snps,dw-apb-gpio";
			reg = <0x00 0x1000e000 0x00 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			porta: gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				snps,nr-gpios = <32>;
				reg = <0>;
				interrupt-parent = <&gic>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			};
		};

		eth: ethernet@10020000 {
			compatible = "snps,dwmac";
			reg = <0x00 0x10020000 0x00 0x10000>;
			interrupts = <GIC_SPI 78 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			clock-names = "stmmaceth", "phy_ref_clk", "aclk";
			phy-mode = "rgmii";
			max-speed = <1000>;
			status = "disabled";
		};

		mmc0: mmc@10040000 {
			compatible = "lynxi,dwcmshc-sdhci";
			reg = <0x00 0x10040000 0x00 0x40000>;
			interrupts = <GIC_SPI 80 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			max-bus-freq = <200000000>;
			min-bus-freq = <400000>;
			power-delay-ms = <0>;
			mmc-hs200-1_8v;
			lynxi,emmc;
			lynxi,io-1v8;
			status = "disabled";

			mmc_disk: disk {
				compatible = "zephyr,mmc-disk";
				disk-name = "SD2";
				bus-width = <8>;
			};
		};

		i2c0: i2c@10002000 {
			compatible = "snps,designware-i2c";
			reg = <0x00 0x10002000 0x00 0x100>;
			interrupts = <GIC_SPI 31 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			clock-frequency = <100000>;
			status = "disabled";
		};

		i2c1: i2c@10003000 {
			compatible = "snps,designware-i2c";
			reg = <0x00 0x10003000 0x00 0x100>;
			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			clock-frequency = <100000>;
			status = "disabled";
		};

		i2c2: i2c@10004000 {
			compatible = "snps,designware-i2c";
			reg = <0x00 0x10004000 0x00 0x100>;
			interrupts = <GIC_SPI 29 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			clock-frequency = <100000>;
			status = "disabled";
		};

		i2c3: i2c@10005000 {
			compatible = "snps,designware-i2c";
			reg = <0x00 0x10005000 0x00 0x100>;
			interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			clock-frequency = <100000>;
			status = "disabled";
		};

		spi0: spi@1000a000 {
			compatible = "snps,dw-apb-ssi";
			reg = <0x00 0x1000a000 0x00 0x1000>;
			interrupts = <GIC_SPI 32 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		dma0: dma@1001a000 {
			compatible = "snps,axi-dma-1.01a";
			reg = <0x00 0x1001a000 0x00 0x400>;
			interrupts = <GIC_SPI 83 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			dma-channels = <4>;
			#dma-cells = <1>;
			status = "disabled";
		};
	};
};
