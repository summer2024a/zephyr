# S4 S905Y4 2GB board configuration

CONFIG_ARM_ARCH_TIMER=y
CONFIG_CACHE_MANAGEMENT=y
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=1000000000
CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000
CONFIG_NUM_IRQS=256

# Console / Shell with GIC interrupt-driven UART
CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_MESON=y
CONFIG_UART_INTERRUPT_DRIVEN=y

CONFIG_SHELL=y
CONFIG_SHELL_BACKEND_SERIAL=y
# Default: IRQ RX + polled TX (stable Shell; see overlay-poll-uart for full poll)
CONFIG_SHELL_BACKEND_SERIAL_INTERRUPT_DRIVEN=y
CONFIG_SHELL_BACKEND_SERIAL_FORCE_TX_BLOCKING_MODE=y
CONFIG_SHELL_BACKEND_SERIAL_TX_RING_BUFFER_SIZE=256
CONFIG_SHELL_BACKEND_SERIAL_LOG_LEVEL_NONE=y
CONFIG_SHELL_THREAD_PRIORITY_OVERRIDE=y
CONFIG_SHELL_THREAD_PRIORITY=10
CONFIG_SHELL_STACK_SIZE=4096
CONFIG_SHELL_TAB=y
CONFIG_SHELL_TAB_AUTOCOMPLETION=y
CONFIG_SHELL_HISTORY=y

CONFIG_KERNEL_SHELL=y
CONFIG_REBOOT=y
CONFIG_SOC_MESON_S4_SHELL_SMP=y

# Logging
CONFIG_LOG=y
CONFIG_LOG_MODE_IMMEDIATE=y

# SMP: PSCI CPU_ON + GIC SGI IPI (4 cores)
# Defer z_smp_init until main() probe (avoid shell+irq-full hang on meson_s4_smp)
CONFIG_SMP=y
CONFIG_SMP_BOOT_DELAY=y
CONFIG_SOC_MESON_S4_SMP_AUTO_PROBE=y
CONFIG_MP_MAX_NUM_CPUS=4
CONFIG_PM_CPU_OPS=y
CONFIG_PM_CPU_OPS_PSCI=y

# GIC + interrupt-driven console/Shell

# SOC prep hook
CONFIG_SOC_PREP_HOOK=y

# ARM64 MMU / VA/PA bits (S4 memory space)
CONFIG_ARM64_VA_BITS_40=y
CONFIG_ARM64_PA_BITS_40=y
CONFIG_ARMV8_A_NS=y

# Boot trace off for SMP/Shell testing (enable for early boot debug)
# CONFIG_SOC_MESON_S4_BOOT_TRACE is not set

# Cache coherency at multiple boot stages (see doc/porting_issues.md)
CONFIG_ARM64_BOOT_DISABLE_DCACHE=y
CONFIG_ARM64_DCACHE_ALL_OPS=y
