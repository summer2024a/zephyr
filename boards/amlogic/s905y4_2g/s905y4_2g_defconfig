# S4 S905Y4 2GB board configuration

CONFIG_ARM_ARCH_TIMER=y
CONFIG_CACHE_MANAGEMENT=y
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=1000000000
CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000
CONFIG_NUM_IRQS=256

# Minimal serial for boot markers + console output
CONFIG_SERIAL=y
CONFIG_UART_MESON=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# SMP - DISABLED for single-core debugging
# CONFIG_SMP is not set

# SOC prep hook - KEEP for boot marker 'P'
CONFIG_SOC_PREP_HOOK=y

# ARM64 MMU / VA/PA bits (S4 memory space)
CONFIG_ARM64_VA_BITS_40=y
CONFIG_ARM64_PA_BITS_40=y
CONFIG_ARMV8_A_NS=y
CONFIG_SOC_MESON_S4_BOOT_TRACE=y

# Cache coherency at multiple boot stages (see PORTING.md)
CONFIG_ARM64_BOOT_DISABLE_DCACHE=y
CONFIG_ARM64_DCACHE_ALL_OPS=y
