if SOC_AMLOGIC_MESON_S4

config SOC_FAMILY
	default "amlogic"

config SOC_SERIES
	default "s4"

config NUM_IRQS
	default 256

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 1000000000

config SYS_CLOCK_TICKS_PER_SEC
	default 1000

config ARM_ARCH_TIMER
	default y

config CACHE_MANAGEMENT
	default y

config SOC_MESON_S4_BOOT_TRACE
	default n

endif