config SOC_AMLOGIC_MESON_S4
	select ARM64
	select CPU_CORTEX_A
	select ARMV8_A
	select ARMV8_A_FP
	select CPU_HAS_MMU
	select ARMV8_A_TIMER
	select CACHE_L2
	select GIC
	select GIC_V2
	select TIMER_ARMv8_CNTVCT
	select SYS_CLOCK_EXISTS
	select SOC_PER_CORE_INIT_HOOK if SMP
	help
	  Amlogic Meson S4 (S905W2/S905Y4) ARM64 SoC (4 Cortex-A55 cores).

	  PSCI firmware in BL31 handles secondary CPU boot via SMC.
	  GIC-400 interrupt controller. Meson UART, DW MAC 3.70a with
	  internal RMII PHY, Meson AXG MMC controller, XHCI USB.

config SOC_MESON_S4_BOOT_TRACE
	bool "S4 boot trace on UART_B (early markers)"
	depends on SOC_AMLOGIC_MESON_S4
	default n
	help
	  Optional early-boot UART trace beyond the always-on boot markers.
	  Adds character markers at key boot stages on UART_B @ 115200.

config SOC_MESON_S4_SHELL_SMP
	bool "Shell command meson_s4_smp (SMP status)"
	depends on SOC_AMLOGIC_MESON_S4 && SHELL
	default n
	help
	  Register meson_s4_smp shell command for PSCI / online CPU check.

config SOC_MESON_S4_SMP_AUTO_PROBE
	bool "Auto z_smp_init from main() after Hello World (debug)"
	depends on SOC_AMLOGIC_MESON_S4 && SMP && SMP_BOOT_DELAY
	default n
	help
	  Call z_smp_init from hello_world main(). Debug only.

config SOC_MESON_S4_SMP_DEFER_INIT
	bool "Defer z_smp_init 3s via k_work (SMP_BOOT_DELAY debug)"
	depends on SOC_AMLOGIC_MESON_S4 && SMP && SMP_BOOT_DELAY
	default n
	help
	  Schedule z_smp_init on system workqueue 3s after boot.
	  Use for SMP validation without Shell.

config SOC_MESON_S4_SMP_DEBUG
	bool "Verbose SMP printk trace on UART"
	depends on SOC_AMLOGIC_MESON_S4 && SMP
	default n
	help
	  Layered s4: / smp: printf in kernel and arch SMP paths.
	  Disable for Shell / production testing.