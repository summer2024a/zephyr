if SOC_LYNXI_KA200

config SOC_FAMILY
	default "lynxi"

config SOC_SERIES
	default "ka200"

config NUM_IRQS
	default 220

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 1000000000

config SYS_CLOCK_TICKS_PER_SEC
	default 100

config ARM_ARCH_TIMER
	default y

config CACHE_MANAGEMENT
	default y

endif